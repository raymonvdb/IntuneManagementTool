<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Intune Management Tool" Width="1440" Height="860" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F3F2F1" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <ResourceDictionary>
@@RESOURCES@@
    </ResourceDictionary>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Bovenbalk -->
    <Border Grid.Row="0" Background="#0B3C5D">
      <DockPanel Margin="16,0" LastChildFill="False">
        <TextBlock DockPanel.Dock="Left" Text="Intune Management Tool" Foreground="White" FontSize="17"
                   FontWeight="SemiBold" VerticalAlignment="Center"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="TxtAccount" Foreground="#C7E0F4" VerticalAlignment="Center" Margin="0,0,16,0"/>
          <Button x:Name="BtnLogin" Content="Aanmelden met Microsoft" Style="{StaticResource HeaderButton}"/>
          <Button x:Name="BtnLoad" Content="Gegevens laden" Style="{StaticResource HeaderPrimary}" IsEnabled="False" Margin="0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Middengedeelte: navigatie links, inhoud rechts -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="White" BorderBrush="#E1DFDD" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="NavPanel" Margin="0,4,0,12"/>
        </ScrollViewer>
      </Border>

      <Grid Grid.Column="1" Margin="20,16,20,12">

        <!-- Dashboard -->
        <ScrollViewer x:Name="PanelDashboard" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="Dashboard" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="TxtDashHint" Foreground="#605E5C" Margin="0,2,0,14" TextWrapping="Wrap"/>
            <WrapPanel x:Name="CardPanel"/>
            <TextBlock Text="Per type" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,6"/>
            <DataGrid x:Name="DashTypeGrid" HeadersVisibility="Column" MaxHeight="380"/>
            <DockPanel Margin="0,18,0,6">
              <Button x:Name="BtnDashExport" DockPanel.Dock="Right" Content="Rapport exporteren" Margin="0"/>
              <TextBlock Text="Belangrijkste aandachtspunten" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <DataGrid x:Name="DashAttentionGrid" HeadersVisibility="Column" MaxHeight="380"/>
          </StackPanel>
        </ScrollViewer>

        <!-- Tabelweergave (gebruikt door bijna alle onderdelen) -->
        <Grid x:Name="PanelTable" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
            <TextBlock x:Name="TxtViewTitle" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="TxtViewHint" Foreground="#605E5C" Margin="0,2,0,10" TextWrapping="Wrap"/>
          </StackPanel>

          <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="TxtCount" Foreground="#605E5C" VerticalAlignment="Center" Margin="0,0,14,0"/>
              <Button x:Name="BtnExport" Content="Exporteren..." Margin="0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Zoeken:" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox x:Name="TxtSearch" Width="260" Margin="0,0,14,0"/>
              <ComboBox x:Name="CmbPlatform" Width="140" Margin="0,0,14,0"/>
              <CheckBox x:Name="ChkUnassigned" Content="Alleen niet (volledig) toegewezen" VerticalAlignment="Center" Margin="0,0,14,0"/>
              <Button x:Name="BtnExtra" Visibility="Collapsed"/>
            </StackPanel>
          </DockPanel>

          <DataGrid x:Name="Grid" Grid.Row="2"/>
          <TextBlock x:Name="TxtEmpty" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="#8A8886" FontSize="15" IsHitTestVisible="False" TextAlignment="Center"/>
        </Grid>

        <!-- Zoeken per groep of gebruiker -->
        <Grid x:Name="PanelSearch" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
            <TextBlock Text="Zoeken op groep of gebruiker" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Foreground="#605E5C" Margin="0,2,0,10" TextWrapping="Wrap"
                       Text="Typ het begin van een groepsnaam, gebruikersnaam of UPN en kies een resultaat. Je ziet dan alles wat aan die groep of gebruiker is toegewezen. Gegevens moeten eerst geladen zijn."/>
          </StackPanel>

          <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
            <Button x:Name="BtnSearchExport" DockPanel.Dock="Right" Content="Exporteren..." Margin="0"/>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBox x:Name="TxtDirQuery" Width="300" Margin="0,0,8,0"/>
              <Button x:Name="BtnSearch" Content="Zoeken" Style="{StaticResource PrimaryButton}"/>
              <CheckBox x:Name="ChkParents" Content="Inclusief bovenliggende (geneste) groepen" IsChecked="True" VerticalAlignment="Center" Margin="8,0,14,0"/>
              <CheckBox x:Name="ChkAll" Content="Toon ook Alle gebruikers / Alle apparaten" IsChecked="True" VerticalAlignment="Center"/>
            </StackPanel>
          </DockPanel>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="320"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="LstCandidates" Grid.Column="0" DisplayMemberPath="Display" BorderBrush="#E1DFDD"/>
            <Grid Grid.Column="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock x:Name="TxtSearchInfo" Grid.Row="0" Margin="0,0,0,8" Foreground="#323130" TextWrapping="Wrap"/>
              <DataGrid x:Name="SearchGrid" Grid.Row="1"/>
            </Grid>
          </Grid>
        </Grid>

      </Grid>
    </Grid>

    <!-- Statusbalk -->
    <Border Grid.Row="2" Background="White" BorderBrush="#E1DFDD" BorderThickness="0,1,0,0" Padding="14,6">
      <DockPanel>
        <Button x:Name="BtnCancel" DockPanel.Dock="Right" Content="Annuleren" Visibility="Collapsed" Padding="10,2" Margin="0"/>
        <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="220" Height="10" Margin="12,0" Visibility="Collapsed"/>
        <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Foreground="#323130" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
