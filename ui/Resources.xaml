<!-- Shared styles. This file contains only the children of a ResourceDictionary;
     the code pastes its content into every window (main window and detail windows). -->

<!-- Buttons -->
<Style TargetType="Button">
  <Setter Property="Background" Value="White"/>
  <Setter Property="Foreground" Value="#201F1E"/>
  <Setter Property="BorderBrush" Value="#8A8886"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Padding" Value="14,6"/>
  <Setter Property="Margin" Value="0,0,8,0"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template">
    <Setter.Value>
      <ControlTemplate TargetType="Button">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.85"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value>
  </Setter>
</Style>

<Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="#0F6CBD"/>
  <Setter Property="Foreground" Value="White"/>
  <Setter Property="BorderBrush" Value="#0F6CBD"/>
</Style>

<Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="Foreground" Value="White"/>
  <Setter Property="BorderBrush" Value="#7FA6C4"/>
</Style>

<Style x:Key="HeaderPrimary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="White"/>
  <Setter Property="Foreground" Value="#0B3C5D"/>
  <Setter Property="BorderBrush" Value="White"/>
</Style>

<!-- Left navigation (like Intune) -->
<Style x:Key="NavButton" TargetType="RadioButton">
  <Setter Property="Foreground" Value="#323130"/>
  <Setter Property="Template">
    <Setter.Value>
      <ControlTemplate TargetType="RadioButton">
        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0"
                Padding="20,8,12,8" Cursor="Hand">
          <ContentPresenter VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F3F2F1"/></Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Bd" Property="Background" Value="#E8F1FA"/>
            <Setter TargetName="Bd" Property="BorderBrush" Value="#0F6CBD"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value>
  </Setter>
</Style>

<Style x:Key="NavHeader" TargetType="TextBlock">
  <Setter Property="Margin" Value="20,16,0,4"/>
  <Setter Property="FontSize" Value="11"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Foreground" Value="#605E5C"/>
</Style>

<!-- Input controls -->
<Style TargetType="TextBox">
  <Setter Property="Padding" Value="6,4"/>
  <Setter Property="BorderBrush" Value="#8A8886"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
</Style>
<Style TargetType="ComboBox">
  <Setter Property="Padding" Value="6,4"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
</Style>
<Style TargetType="CheckBox">
  <Setter Property="VerticalContentAlignment" Value="Center"/>
</Style>

<!-- Tables -->
<Style TargetType="DataGrid">
  <Setter Property="Background" Value="White"/>
  <Setter Property="BorderBrush" Value="#E1DFDD"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="GridLinesVisibility" Value="Horizontal"/>
  <Setter Property="HorizontalGridLinesBrush" Value="#EDEBE9"/>
  <Setter Property="RowHeaderWidth" Value="0"/>
  <Setter Property="AutoGenerateColumns" Value="False"/>
  <Setter Property="IsReadOnly" Value="True"/>
  <Setter Property="CanUserAddRows" Value="False"/>
  <Setter Property="AlternatingRowBackground" Value="#FAF9F8"/>
  <Setter Property="SelectionMode" Value="Single"/>
</Style>

<Style TargetType="DataGridColumnHeader">
  <Setter Property="Background" Value="#FAF9F8"/>
  <Setter Property="Foreground" Value="#323130"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Padding" Value="8,7"/>
  <Setter Property="BorderBrush" Value="#E1DFDD"/>
  <Setter Property="BorderThickness" Value="0,0,1,1"/>
  <Setter Property="HorizontalContentAlignment" Value="Left"/>
</Style>

<Style TargetType="DataGridCell">
  <Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Padding" Value="2,2"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Style.Triggers>
    <Trigger Property="IsSelected" Value="True">
      <Setter Property="Background" Value="#CCE4F7"/>
      <Setter Property="Foreground" Value="#201F1E"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Trigger>
  </Style.Triggers>
</Style>

<Style TargetType="DataGridRow">
  <Setter Property="MinHeight" Value="28"/>
  <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F3F9FD"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#CCE4F7"/></Trigger>
  </Style.Triggers>
</Style>

<!-- Cell styles for columns (text wrapping; status with color) -->
<Style x:Key="WrapCell" TargetType="TextBlock">
  <Setter Property="TextWrapping" Value="Wrap"/>
  <Setter Property="Margin" Value="6,3"/>
  <Setter Property="VerticalAlignment" Value="Top"/>
</Style>

<Style x:Key="StatusCell" TargetType="TextBlock" BasedOn="{StaticResource WrapCell}">
  <Style.Triggers>
    <DataTrigger Binding="{Binding Status}" Value="Not assigned"><Setter Property="Foreground" Value="#C50F1F"/></DataTrigger>
    <DataTrigger Binding="{Binding Status}" Value="Exclusion only"><Setter Property="Foreground" Value="#B45F06"/></DataTrigger>
    <DataTrigger Binding="{Binding Status}" Value="Assigned"><Setter Property="Foreground" Value="#107C10"/></DataTrigger>
  </Style.Triggers>
</Style>

<Style x:Key="SeverityCell" TargetType="TextBlock" BasedOn="{StaticResource WrapCell}">
  <Style.Triggers>
    <DataTrigger Binding="{Binding Severity}" Value="Error"><Setter Property="Foreground" Value="#C50F1F"/></DataTrigger>
    <DataTrigger Binding="{Binding Severity}" Value="Warning"><Setter Property="Foreground" Value="#B45F06"/></DataTrigger>
  </Style.Triggers>
</Style>

<Style x:Key="ComplianceCell" TargetType="TextBlock" BasedOn="{StaticResource WrapCell}">
  <Style.Triggers>
    <DataTrigger Binding="{Binding Compliance}" Value="noncompliant"><Setter Property="Foreground" Value="#C50F1F"/></DataTrigger>
    <DataTrigger Binding="{Binding Compliance}" Value="compliant"><Setter Property="Foreground" Value="#107C10"/></DataTrigger>
  </Style.Triggers>
</Style>

<Style x:Key="StateCell" TargetType="TextBlock" BasedOn="{StaticResource WrapCell}">
  <Style.Triggers>
    <DataTrigger Binding="{Binding State}" Value="error"><Setter Property="Foreground" Value="#C50F1F"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="nonCompliant"><Setter Property="Foreground" Value="#C50F1F"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="conflict"><Setter Property="Foreground" Value="#B45F06"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="compliant"><Setter Property="Foreground" Value="#107C10"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="succeeded"><Setter Property="Foreground" Value="#107C10"/></DataTrigger>
  </Style.Triggers>
</Style>
